FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements-live.lock .
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-live.lock

COPY model_service/__init__.py model_service/authorization.py model_service/contracts.py ./model_service/
COPY live_pocs ./live_pocs

RUN groupadd --system poc \
    && useradd --system --gid poc --create-home --home-dir /home/poc poc

USER poc
EXPOSE 8080

CMD ["python", "-m", "uvicorn", "live_pocs.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
